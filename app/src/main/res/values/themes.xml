<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Тёмное окно под Compose-тему: нет белых вспышек при запуске, системные панели в цвет фона. -->
    <style name="Theme.Twv" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/twv_background</item>
        <item name="android:colorBackground">@color/twv_background</item>
        <item name="android:statusBarColor">@color/twv_background</item>
        <item name="android:navigationBarColor">@color/twv_background</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
</resources>
